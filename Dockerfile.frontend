FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/next.config.ts frontend/postcss.config.mjs frontend/tsconfig.json ./
COPY frontend/public ./public
COPY frontend/src ./src
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/out ./out
COPY frontend/scripts/preview.mjs ./scripts/preview.mjs
# A porta publicada pelo Compose precisa alcançar a interface do contêiner.
RUN sed -i "s/server.listen(port, '127.0.0.1',/server.listen(port, '0.0.0.0',/" scripts/preview.mjs \
    && grep -Fq "server.listen(port, '0.0.0.0'," scripts/preview.mjs
ENV PORT=3000
USER node
CMD ["node", "scripts/preview.mjs"]
